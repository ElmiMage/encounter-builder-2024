<div class="encounter-builder-2024">
<div class="scrollable-content">

  <nav class="eb-tabs">
    <button type="button" class="eb-tab-button" data-action="switchTab" data-tab="encounter">Encounter</button>
    <button type="button" class="eb-tab-button" data-action="switchTab" data-tab="loot">Individual Treasure</button>
    <button type="button" class="eb-tab-button" data-action="switchTab" data-tab="hoard">Treasure Hoard</button>
    <button type="button" class="eb-help-btn square-btn" data-action="showHelp" title="What do these buttons do?">?</button>
  </nav>

  <section class="party-config">
    <label>
      Party Level
      <select name="partyLevel" tabindex="1">
        {{#each levelOptions}}
          <option value="{{this}}" {{#if (eq this ../partyLevel)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      Party Size
      <select name="partySize" tabindex="2">
        {{#each sizeOptions}}
          <option value="{{this}}" {{#if (eq this ../partySize)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      Difficulty
      <select name="difficulty" tabindex="3">
        <option value="low" {{#if (eq difficulty "low")}}selected{{/if}}>Low</option>
        <option value="moderate" {{#if (eq difficulty "moderate")}}selected{{/if}}>Moderate</option>
        <option value="high" {{#if (eq difficulty "high")}}selected{{/if}}>High</option>
      </select>
    </label>
    <button type="button" data-action="syncParty" title="Reads Foundry's designated Party actor (dnd5e's Group/Party feature) and sets Party Level/Size from its current characters">Sync from Party</button>
  </section>

  <section class="budget-bar">
    <div class="budget-label">
      {{spend.spent}} / {{budget}} XP
      {{#if spend.overBudget}}<span class="over-budget">OVER BUDGET</span>{{/if}}
    </div>
    <div class="budget-track">
      {{#if spend.overBudget}}
        <div class="budget-fill" style="width: 100%; background: linear-gradient(to right, #2e7d32 0%, #2e7d32 {{budgetMarkerPercent}}%, #c62828 {{budgetMarkerPercent}}%, #c62828 100%);"></div>
        <div class="budget-marker" style="left: {{budgetMarkerPercent}}%"></div>
      {{else}}
        <div class="budget-fill" style="width: {{spendPercentClamped}}%"></div>
      {{/if}}
    </div>
  </section>

  {{#if (eq activeTab "encounter")}}

  <details class="compendium-tree" data-tree="encounter" {{#if compendiumTreeOpen}}open{{/if}}>
    <summary>Compendiums ({{compendiums.length}} packs)</summary>
    {{#each groupedCompendiums}}
      <details class="compendium-group" data-group="{{this.groupKey}}" {{#if this.isOpen}}open{{/if}}>
        <summary>
          <input type="checkbox" class="{{#if this.mixed}}mixed-state{{/if}}" data-action="toggleCompendiumGroup" data-group="{{this.groupKey}}" {{#if this.allEnabled}}checked{{/if}} />
          {{#if this.mixed}}<span class="mixed-marker" title="Some packs in this group are selected">●</span>{{/if}}
          {{this.groupLabel}}
        </summary>
        <div class="compendium-group-packs">
          {{#each this.packs}}
            <label class="compendium-toggle">
              <input type="checkbox" data-action="toggleCompendium" data-collection="{{this.collection}}" {{#if this.enabled}}checked{{/if}} />
              {{this.label}} <span class="pack-count">({{this.total}})</span>
            </label>
          {{/each}}
        </div>
      </details>
    {{/each}}
  </details>

  <section class="auto-fill-controls">
    <label>
      Desired Monster Count
      <select name="desiredCount">
        {{#each desiredCountOptions}}
          <option value="{{this}}" {{#if (eq this ../desiredCount)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      Creature Type
      <select name="creatureTypeFilter">
        <option value="any" {{#if (eq creatureTypeFilter "any")}}selected{{/if}}>Any</option>
        {{#each creatureTypes}}
          <option value="{{this}}" {{#if (eq ../creatureTypeFilter this)}}selected{{/if}}>{{humanize this}}</option>
        {{/each}}
      </select>
    </label>
    <button type="button" data-action="autoFill">Auto-Fill Remaining</button>
    <label class="boss-mode-toggle">
      <input type="checkbox" name="bossMode" {{#if bossMode}}checked{{/if}} />
      Boss Encounter
    </label>
  </section>

  {{#if autoFillWarning}}
    <p class="auto-fill-warning">{{autoFillWarning}}</p>
  {{/if}}

  <div class="builder-columns">

    <section class="monster-browser">
      <div class="monster-filter-row">
        <input type="search" name="searchTerm" placeholder="Search monsters..." value="{{searchTerm}}" />
        <select name="crFilter">
          <option value="any" {{#if (eq crFilter "any")}}selected{{/if}}>Any CR</option>
          {{#each availableCrs}}
            <option value="{{this.value}}" {{#if (eq ../crFilter this.value)}}selected{{/if}}>CR {{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="monster-filter-row monster-filter-row-secondary">
        <select name="sizeFilter">
          <option value="any" {{#if (eq sizeFilter "any")}}selected{{/if}}>Any Size</option>
          {{#each availableSizes}}
            <option value="{{this.value}}" {{#if (eq ../sizeFilter this.value)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <select name="subtypeFilter">
          <option value="any" {{#if (eq subtypeFilter "any")}}selected{{/if}}>Any Subtype</option>
          {{#each availableSubtypes}}
            <option value="{{this}}" {{#if (eq ../subtypeFilter this)}}selected{{/if}}>{{humanize this}}</option>
          {{/each}}
        </select>
        {{#if availableHabitats.length}}
          <select name="habitatFilter">
            <option value="any" {{#if (eq habitatFilter "any")}}selected{{/if}}>Any Habitat</option>
            {{#each availableHabitats}}
              <option value="{{this}}" {{#if (eq ../habitatFilter this)}}selected{{/if}}>{{humanize this}}</option>
            {{/each}}
          </select>
        {{/if}}
      </div>
      <ul class="monster-list">
        {{#each monsters}}
          <li class="monster-entry" draggable="true" data-action="viewMonster" data-uuid="{{this.uuid}}" title="Click to view stat block, or drag onto the canvas to place a token">
            <img src="{{this.img}}" width="24" height="24" />
            <span class="monster-name" title="{{this.name}}">{{this.name}}</span>
            <span class="monster-cr">CR {{this.cr}}</span>
            <span class="monster-xp">{{#if this.xp}}{{this.xp}}{{else}}?{{/if}} XP</span>
            <span class="monster-source">{{this.sourceLabel}}</span>
            <button type="button" class="add-item-btn square-btn" data-action="addMonster" data-uuid="{{this.uuid}}" title="Add to encounter">+</button>
          </li>
        {{/each}}
      </ul>
    </section>

    <section class="encounter-list">
      <h3 class="encounter-header">
        <span>Encounter</span>
        <label class="encounter-hp-multiplier" title="Determines every monster's HP in this encounter when Create Combat runs. Independent of Boss-ify.">
          Encounter HP:
          <select name="encounterHpMode">
            <option value="raw" {{#if (eq encounterHpMode "raw")}}selected{{/if}}>RAW (printed)</option>
            <option value="minroll" {{#if (eq encounterHpMode "minroll")}}selected{{/if}}>Minroll</option>
            <option value="maxroll" {{#if (eq encounterHpMode "maxroll")}}selected{{/if}}>Maxroll</option>
          </select>
        </label>
        <button type="button" class="delete-btn square-btn" data-action="reset" title="Clear entire encounter"><i class="fas fa-trash"></i></button>
      </h3>
      <div class="preset-row">
        <select name="presetSelect">
          <option value="">— Select Preset —</option>
          {{#each presets}}
            <option value="{{this.name}}">{{this.name}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="loadPreset" title="Replace the current encounter list and party fields with the selected preset">Load</button>
        <button type="button" data-action="savePreset" title="Save the current encounter list and party fields as a named preset, visible to every GM in this world">Save As…</button>
        <button type="button" class="delete-btn square-btn" data-action="deletePreset" title="Delete the selected preset">×</button>
      </div>
      <ul>
        {{#each encounterEntries}}
          <li>
            <span>{{this.count}}x <span class="entry-name-link" data-action="viewMonster" data-uuid="{{this.monster.uuid}}" title="Click to view stat block">{{this.monster.name}}</span> ({{#if this.effectiveXp}}{{this.effectiveXp}}{{else}}?{{/if}} XP each{{#if this.inLair}}, in lair{{/if}})</span>
            <span class="qty-buttons">
              {{#if this.monster.hasLairActions}}
                <label class="lair-toggle" title="Fighting in its own lair — adjusts XP to CR+1, matching the 2024/2025 Monster Manual's lair-action fix">
                  <input type="checkbox" data-action="toggleLair" data-uuid="{{this.monster.uuid}}" {{#if this.inLair}}checked{{/if}} /> Lair
                </label>
              {{/if}}
              {{#if ../bossMode}}
                <button type="button" class="eb-toggle-pill {{#if this.isBoss}}active{{/if}}" data-action="toggleBoss" data-uuid="{{this.monster.uuid}}" title="Mark this monster as the encounter's boss — enables Boss-ify scaling for it, whether it came from Auto-Fill or was added manually">Boss</button>
              {{/if}}
              {{#if this.isBoss}}
                <button type="button" data-action="openBossifyDialog" data-uuid="{{this.monster.uuid}}" title="Preview and choose a difficulty tier to scale this boss's HP, damage, AC and ability scores">
                  Boss-ify{{#if this.bossifyTier}} ({{humanize this.bossifyTier}}){{/if}}…
                </button>
                {{#if this.bossifiedActorId}}
                  <button type="button" data-action="revertBossify" data-actor-id="{{this.bossifiedActorId}}" title="Restore this boss's original stats">Revert</button>
                {{/if}}
              {{/if}}
              <button type="button" class="eb-toggle-pill {{#if this.minionify}}active{{/if}}" data-action="toggleMinionify" data-uuid="{{this.monster.uuid}}" title="Convert to MCDM Minion stats (Flee, Mortals!) at Create Combat — fixed low HP and flat damage per hit for this CR, no AC/attack changes">Minion</button>
              {{#if this.minionifiedActorId}}
                <button type="button" data-action="revertMinionify" data-actor-id="{{this.minionifiedActorId}}" title="Restore this monster's original stats">Revert</button>
              {{/if}}
              <button type="button" data-action="removeMonster" data-uuid="{{this.monster.uuid}}">−</button>
              <button type="button" data-action="addMonster" data-uuid="{{this.monster.uuid}}">+</button>
              <button type="button" class="delete-btn" data-action="deleteMonster" data-uuid="{{this.monster.uuid}}">×</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </section>

  </div>

  {{/if}}

  {{#if (or (eq activeTab "hoard") (eq activeTab "loot"))}}

  <details class="compendium-tree" data-tree="loot" {{#if lootCompendiumTreeOpen}}open{{/if}}>
    <summary>Item Compendiums ({{lootCompendiums.length}} packs)</summary>
    {{#each groupedLootCompendiums}}
      <details class="compendium-group" data-group="{{this.groupKey}}" {{#if this.isOpen}}open{{/if}}>
        <summary>
          <input type="checkbox" class="{{#if this.mixed}}mixed-state{{/if}}" data-action="toggleLootGroup" data-group="{{this.groupKey}}" {{#if this.allEnabled}}checked{{/if}} />
          {{#if this.mixed}}<span class="mixed-marker" title="Some packs in this group are selected">●</span>{{/if}}
          {{this.groupLabel}}
        </summary>
        <div class="compendium-group-packs">
          {{#each this.packs}}
            <label class="compendium-toggle">
              <input type="checkbox" data-action="toggleLootCompendium" data-collection="{{this.collection}}" {{#if this.enabled}}checked{{/if}} />
              {{this.label}} <span class="pack-count">({{this.total}})</span>
            </label>
          {{/each}}
        </div>
      </details>
    {{/each}}
  </details>

  {{/if}}

  {{#if (eq activeTab "loot")}}

  <section class="loot-header">
    <p>Individual Treasure (2024 DMG) — the incidental coin (and any items you add below) a single non-hoarding monster carries, distinct from a Treasure Hoard. Coins are rolled once per creature currently selected in the Encounter tab ({{individualTreasureCreatureCount}} creature(s)), then summed into one purse.</p>
    <button type="button" data-action="rollIndividualTreasure">Roll Individual Treasure</button>
  </section>

  <div class="builder-columns">

    <section class="monster-browser">
      <div class="monster-filter-row">
        <input type="search" name="individualSearchTerm" placeholder="Search items..." value="{{individualSearchTerm}}" />
        <select name="individualRarityFilter">
          <option value="any" {{#if (eq individualRarityFilter "any")}}selected{{/if}}>Any Rarity</option>
          {{#each availableLootRarities}}
            <option value="{{this}}" {{#if (eq ../individualRarityFilter this)}}selected{{/if}}>{{humanize this}}</option>
          {{/each}}
        </select>
        <select name="individualCategoryFilter">
          <option value="any" {{#if (eq individualCategoryFilter "any")}}selected{{/if}}>Any Type</option>
          {{#each availableLootCategories}}
            <option value="{{this}}" {{#if (eq ../individualCategoryFilter this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <ul class="monster-list loot-item-list">
        {{#each lootItems}}
          <li class="loot-item-entry" draggable="true" data-action="viewLootItem" data-uuid="{{this.uuid}}" title="Click to view description, or drag onto the canvas/an actor sheet">
            <img src="{{this.img}}" width="24" height="24" />
            <span class="monster-name" title="{{this.name}}">{{this.name}}</span>
            <span class="monster-cr">{{humanize this.rarity}}</span>
            <span class="monster-source">{{this.sourceLabel}}</span>
            <button type="button" class="add-item-btn square-btn" data-action="addLootItem" data-uuid="{{this.uuid}}" title="Add to plan">+</button>
          </li>
        {{/each}}
      </ul>
    </section>

    <section class="encounter-list loot-plan-column">
      <h3>Coins ({{individualTreasureRolledCount}} creature(s) rolled)</h3>
      <div class="loot-coin-row">
        <label>CP <input type="number" name="individualCoin-cp" min="0" value="{{individualTreasureCoins.cp}}" /></label>
        <label>SP <input type="number" name="individualCoin-sp" min="0" value="{{individualTreasureCoins.sp}}" /></label>
        <label>EP <input type="number" name="individualCoin-ep" min="0" value="{{individualTreasureCoins.ep}}" /></label>
        <label>GP <input type="number" name="individualCoin-gp" min="0" value="{{individualTreasureCoins.gp}}" /></label>
        <label>PP <input type="number" name="individualCoin-pp" min="0" value="{{individualTreasureCoins.pp}}" /></label>
      </div>

      <h3>Items</h3>
      <ul>
        {{#each individualTreasureItems}}
          <li>
            <span>{{this.count}}x <span class="entry-name-link" data-action="viewLootItem" data-uuid="{{this.uuid}}" title="Click to view item">{{this.name}}</span> <em>({{humanize this.rarity}})</em>{{#if this.customization}}<span class="customized-marker" title="Customized — homebrew name/bonus/damage">✨</span>{{/if}}</span>
            <span class="qty-buttons">
              {{#if this.canCustomize}}
                <button type="button" data-action="customizeLootItem" data-key="{{this.key}}" title="Give this specific copy a custom name, magic bonus, and/or extra damage/resistance type">Customize…</button>
              {{/if}}
              <button type="button" data-action="removeLootItem" data-key="{{this.key}}">−</button>
              <button type="button" data-action="addLootItem" data-key="{{this.key}}">+</button>
              <button type="button" class="delete-btn" data-action="deleteLootItem" data-key="{{this.key}}">×</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </section>

  </div>

  {{/if}}

  {{#if (eq activeTab "hoard")}}

  <section class="loot-header">
    <p>Hoard tier is based on party level (currently level {{hoardTierBasis}}), unless overridden below. Highest monster CR in your encounter: {{highestCr}} — shown for reference only, no longer used for the tier.</p>
    <label class="loot-basis-select">
      Loot Basis
      <select name="hoardLootBasis">
        <option value="auto" {{#if (eq hoardLootBasis "auto")}}selected{{/if}}>Tier (RAW)</option>
        {{#each lootLevelOptions}}
          <option value="{{this}}" {{#if (eq ../hoardLootBasis this)}}selected{{/if}}>Level {{this}} (homebrew)</option>
        {{/each}}
      </select>
    </label>
    <button type="button" data-action="rollHoard">Roll Suggested Hoard (DMG 2024)</button>
    {{#if hoardPlan.tier}}
      <button type="button" data-action="rerollHoard">Reroll Magic Items</button>
      <span class="loot-tier-label">
        Tier {{hoardPlan.tier}}
        {{#if (eq hoardPlan.confidence "approximate")}}<span class="over-budget">(approximate — verify against your book)</span>{{/if}}
        {{#if (eq hoardPlan.confidence "homebrew")}}<span class="loot-homebrew-label">(homebrew — smoothed, not official DMG content)</span>{{/if}}
      </span>
    {{/if}}
  </section>

  <div class="builder-columns">

    <section class="monster-browser">
      <div class="monster-filter-row">
        <input type="search" name="hoardSearchTerm" placeholder="Search items..." value="{{hoardSearchTerm}}" />
        <select name="hoardRarityFilter">
          <option value="any" {{#if (eq hoardRarityFilter "any")}}selected{{/if}}>Any Rarity</option>
          {{#each availableLootRarities}}
            <option value="{{this}}" {{#if (eq ../hoardRarityFilter this)}}selected{{/if}}>{{humanize this}}</option>
          {{/each}}
        </select>
        <select name="hoardCategoryFilter">
          <option value="any" {{#if (eq hoardCategoryFilter "any")}}selected{{/if}}>Any Type</option>
          {{#each availableLootCategories}}
            <option value="{{this}}" {{#if (eq ../hoardCategoryFilter this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <ul class="monster-list loot-item-list">
        {{#each lootItems}}
          <li class="loot-item-entry" draggable="true" data-action="viewLootItem" data-uuid="{{this.uuid}}" title="Click to view description, or drag onto the canvas/an actor sheet">
            <img src="{{this.img}}" width="24" height="24" />
            <span class="monster-name" title="{{this.name}}">{{this.name}}</span>
            <span class="monster-cr">{{humanize this.rarity}}</span>
            <span class="monster-source">{{this.sourceLabel}}</span>
            <button type="button" class="add-item-btn square-btn" data-action="addLootItem" data-uuid="{{this.uuid}}" title="Add to plan">+</button>
          </li>
        {{/each}}
      </ul>
    </section>

    <section class="encounter-list loot-plan-column">
      <h3>Coins</h3>
      <div class="loot-coin-row">
        <label>CP <input type="number" name="hoardCoin-cp" min="0" value="{{hoardPlanCoins.cp}}" /></label>
        <label>SP <input type="number" name="hoardCoin-sp" min="0" value="{{hoardPlanCoins.sp}}" /></label>
        <label>EP <input type="number" name="hoardCoin-ep" min="0" value="{{hoardPlanCoins.ep}}" /></label>
        <label>GP <input type="number" name="hoardCoin-gp" min="0" value="{{hoardPlanCoins.gp}}" /></label>
        <label>PP <input type="number" name="hoardCoin-pp" min="0" value="{{hoardPlanCoins.pp}}" /></label>
      </div>

      <h3>Gems</h3>
      <div class="loot-coin-row">
        <label>Count <input type="number" name="hoardGemsArtCount" min="0" value="{{hoardPlanGemsOrArt.count}}" /></label>
        <label>GP each <input type="number" name="hoardGemsArtValue" min="0" value="{{hoardPlanGemsOrArt.unitValue}}" /></label>
      </div>

      <h3>Magic Items by Rarity</h3>
      <div class="loot-rarity-rows">
        {{#each rarityRows}}
          <label class="loot-rarity-row">
            {{humanize this.rarity}}
            <input type="number" name="hoardRarity-{{this.rarity}}" min="0" value="{{this.count}}" />
          </label>
        {{/each}}
      </div>

      <h3>Items</h3>
      <ul>
        {{#each hoardPlanItems}}
          <li>
            <span>{{this.count}}x <span class="entry-name-link" data-action="viewLootItem" data-uuid="{{this.uuid}}" title="Click to view item">{{this.name}}</span> <em>({{humanize this.rarity}})</em>{{#if this.customization}}<span class="customized-marker" title="Customized — homebrew name/bonus/damage">✨</span>{{/if}}</span>
            <span class="qty-buttons">
              {{#if this.canCustomize}}
                <button type="button" data-action="customizeLootItem" data-key="{{this.key}}" title="Give this specific copy a custom name, magic bonus, and/or extra damage/resistance type">Customize…</button>
              {{/if}}
              {{#if (eq this.source "rolled")}}
                <button type="button" data-action="rerollItem" data-key="{{this.key}}" title="Reroll just this item (same rarity, new pick)">🎲</button>
              {{/if}}
              <button type="button" data-action="removeLootItem" data-key="{{this.key}}">−</button>
              <button type="button" data-action="addLootItem" data-key="{{this.key}}">+</button>
              <button type="button" class="delete-btn" data-action="deleteLootItem" data-key="{{this.key}}">×</button>
            </span>
          </li>
        {{/each}}
      </ul>
    </section>

  </div>

  {{/if}}

  </div>

  <footer>
    <button type="button" data-action="reset">Reset Encounter</button>
    <button type="button" data-action="generateLoot">Place Loot</button>
    <button type="button" data-action="createCombat">Deploy Encounter</button>
  </footer>

</div>
